+/* A surface (including its client-side shadow) can touch multiple outputs.
+ * Follow the fastest intersecting output rather than the last enter event. */
+static struct wl_output *
+gdk_wayland_surface_get_fastest_output (GdkWaylandSurface *impl)
+{
+  GdkWaylandDisplay *display = GDK_WAYLAND_DISPLAY (gdk_surface_get_display (GDK_SURFACE (impl)));
+  struct wl_output *selected = NULL;
+  int selected_refresh = -1;
+
+  for (GSList *l = impl->display_server.outputs; l; l = l->next)
+    {
+      GdkMonitor *monitor = gdk_wayland_display_get_monitor (display, l->data);
+      int refresh = monitor ? gdk_monitor_get_refresh_rate (monitor) : 0;
+      if (refresh > selected_refresh)
+        {
+          selected = l->data;
+          selected_refresh = refresh;
+        }
+    }
+
+  return selected;
+}
