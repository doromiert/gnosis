<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2013, 2015, 2019 Epiphany contributors -->
<component type="desktop-application">
  <id>@appid@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <name>Jupiter</name>
  <summary>Browse the web</summary>
  <description>
    <p>Jupiter brings the GNOME Web interface to Chromium Embedded Framework.</p>
    <p>Based on Epiphany, with its native GTK and libadwaita interface.
       The engine replacement is under development.</p>
  </description>
  <screenshots>
    <screenshot type="default">
      <caption>A browser window</caption>
      <image>https://gitlab.gnome.org/GNOME/epiphany/raw/HEAD/data/screenshot.png</image>
    </screenshot>
  </screenshots>
  <kudos>
    <kudo>AppMenu</kudo>
    <kudo>HiDpiIcon</kudo>
    <kudo>ModernToolkit</kudo>
    <kudo>SearchProvider</kudo>
    <kudo>UserDocs</kudo>
  </kudos>
  <project_license>GPL-3.0+</project_license>
  <!-- developer_name tag deprecated with Appstream 1.0 -->
  <developer_name>Jupiter contributors</developer_name>
  <developer id="io.github.doromiert">
    <name>Jupiter contributors</name>
  </developer>
  <url type="homepage">https://github.com/doromiert/jupiter-browser</url>
  <url type="bugtracker">https://github.com/doromiert/jupiter-browser/issues</url>
  <url type="vcs-browser">https://github.com/doromiert/jupiter-browser</url>
  <translation type="gettext">jupiter</translation>
  <provides>
    <binary>jupiter</binary>
  </provides>
  <launchable type="desktop-id">@appid@.desktop</launchable>
  <content_rating type="oars-1.1" />
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </recommends>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <releases>
    <release date="2026-10-15" version="0.1.0" type="development">
      <description>
        <p>Initial development version of the CEF port, based on Epiphany 51.1.</p>
      </description>
    </release>
  </releases>
</component>
