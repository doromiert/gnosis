using Gtk 4.0;
using Adw 1;

template $PrefsExtensionsPage: Adw.PreferencesPage {
  icon-name: "application-x-addon-symbolic";
  title: _("Extensions");

  Adw.PreferencesGroup install_group {
    Adw.ActionRow {
      title: _("Install from Online Extension Store…");
      subtitle: _("Browse Chromium extensions");
      activatable-widget: store_button;

      [suffix]
      MenuButton store_button {
        icon-name: "go-next-symbolic";
        tooltip-text: _("Choose an Extension Store");
        valign: center;
        styles [ "flat" ]
        popover: PopoverMenu {
          menu-model: extension_stores;
        };
      }
    }

    Adw.ActionRow native_install_row {
      activatable: true;
      title: _("Install Unpacked Extension…");
      subtitle: _("Select a folder containing manifest.json");
      use-underline: true;
      activated => $on_install_unpacked_clicked();

      [suffix]
      Image {
        icon-name: "list-add-symbolic";
      }
    }


  }

  Adw.PreferencesGroup {
    Stack stack {
      StackPage {
        name: "list";

        child: ListBox listbox {
          selection-mode: none;

          styles [
            "boxed-list",
          ]
        };
      }

      StackPage {
        name: "empty";

        child: Label {
          label: _("No Extensions Installed");
          wrap: true;
          xalign: 0.5;
          height-request: 50;

          styles [
            "card",
            "dim-label",
          ]
        };
      }
    }
  }
}

menu extension_stores {
  item {
    label: _("Chrome Web Store");
    action: "extension-store.open";
    target: "chrome";
  }
  item {
    label: _("Microsoft Edge Add-ons");
    action: "extension-store.open";
    target: "edge";
  }
}
