+CefString CefFrameImpl::InsertUserStyleSheet(const CefString& css) {
+  CefString result;
+  CEF_REQUIRE_RT_RETURN(result);
+
+  if (!frame_ || css.empty()) {
+    return result;
+  }
+  auto document = frame_->GetDocument();
+  if (document.IsNull()) {
+    return result;
+  }
+
+  if (user_style_document_ != document.Token()) {
+    user_style_keys_.clear();
+    user_style_document_ = document.Token();
+  }
+  const auto key = document.InsertStyleSheet(
+      blink::WebString::FromUtf16(css.ToString16()), nullptr,
+      blink::WebCssOrigin::kUser,
+      blink::BackForwardCacheAware::kPossiblyDisallow);
+  if (!key.IsEmpty()) {
+    user_style_keys_.insert(key.Utf16());
+    result = key.Utf16();
+  }
+  return result;
+}
+
+bool CefFrameImpl::RemoveUserStyleSheet(const CefString& key) {
+  CEF_REQUIRE_RT_RETURN(false);
+
+  if (!frame_ || key.empty()) {
+    return false;
+  }
+  auto document = frame_->GetDocument();
+  if (document.IsNull()) {
+    return false;
+  }
+  if (user_style_document_ != document.Token()) {
+    user_style_keys_.clear();
+    user_style_document_ = document.Token();
+    return false;
+  }
+  const auto it = user_style_keys_.find(key.ToString16());
+  if (it == user_style_keys_.end()) {
+    return false;
+  }
+  document.RemoveInsertedStyleSheet(blink::WebString::FromUtf16(*it),
+                                   blink::WebCssOrigin::kUser);
+  user_style_keys_.erase(it);
+  return true;
+}
