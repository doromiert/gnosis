+
+void ChromeContentRendererClientCef::RunScriptsAtDocument(
+    content::RenderFrame* render_frame,
+    bool at_start) {
+  const auto run_chrome = [this, render_frame, at_start] {
+    if (at_start) {
+      ChromeContentRendererClient::RunScriptsAtDocumentStart(render_frame);
+    } else {
+      ChromeContentRendererClient::RunScriptsAtDocumentEnd(render_frame);
+    }
+  };
+  if (!CEF_API_IS_ADDED(CEF_EXPERIMENTAL)) {
+    run_chrome();
+    return;
+  }
+
+  auto* web_frame = render_frame->GetWebFrame();
+  auto browser = CefBrowserImpl::GetBrowserForMainFrame(web_frame->Top());
+  CefRefPtr<CefFrameImpl> frame;
+  std::optional<blink::DocumentToken> document_token;
+  if (browser) {
+    frame = browser->GetWebFrameImpl(web_frame);
+    auto document = web_frame->GetDocument();
+    if (!document.IsNull()) {
+      document_token = document.Token();
+    }
+  }
+
+  // Chrome's injections may destroy render_frame. Use only retained CEF objects
+  // after this call, and do not deliver the old document's event to a new one.
+  run_chrome();
+  if (!browser || !browser->IsValid() || !frame || !frame->IsValid() ||
+      !document_token) {
+    return;
+  }
+  auto document = frame->web_frame()->GetDocument();
+  if (document.IsNull() || document.Token() != *document_token) {
+    return;
+  }
+
+  auto app = CefAppManager::Get()->GetApplication();
+  auto handler = app ? app->GetRenderProcessHandler() : nullptr;
+  if (handler) {
+    if (at_start) {
+      handler->OnDocumentStart(browser, frame);
+    } else {
+      handler->OnDocumentEnd(browser, frame);
+    }
+  }
