+void CefRequestContextImpl::GetInstalledExtensions(
+    CefRefPtr<CefExtensionManagementCallback> callback) {
+  if (!callback) {
+    DCHECK(false) << "callback is required";
+    return;
+  }
+  callback = new ExtensionManagementCompletion(callback, std::string());
+  GetBrowserContext(
+      content::GetUIThreadTaskRunner({}),
+      base::BindOnce(&ExtensionManagementOperation::Start,
+                     ExtensionManagementOperation::Kind::kSnapshot,
+                     std::string(), false, std::move(callback)));
+}
