{
  "manifest_version": 3,
  "name": "Gnosis extension integration fixture",
  "version": "1.0",
  "permissions": [
    "storage",
    "tabs",
    "webRequest",
    "scripting",
    "declarativeNetRequest"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "fixture",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
